# Copy this file to `.env` and configure ONE LLM provider + Bedrock image access.
# A real LLM is REQUIRED — there is no offline mock mode.
# LLM_PROVIDER must be set explicitly to: openai | bedrock | vllm.

# --- OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# DEMO_MODEL=gpt-4o-mini

# --- Self-hosted vLLM (OpenAI-compatible) ---
# LLM_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8001/v1
# DEMO_MODEL=Qwen/Qwen2.5-7B-Instruct
# VLLM_API_KEY=EMPTY

# --- AWS Bedrock (text model) ---
# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
# DEMO_MODEL=us.anthropic.claude-sonnet-4-6   # cross-region inference profile

# --- Bedrock image generation (REQUIRED: design artwork) ---
# Needs AWS credentials with Bedrock access to the Stability SD3.5 model.
# The preview is composited locally, so no inpaint model is needed.
AWS_BEDROCK_REGION=us-west-2       # Stability image model region (falls back to AWS_REGION)
IMAGE_MODEL=stability.sd3-5-large-v1:0
